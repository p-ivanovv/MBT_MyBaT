# Supabase Project
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Connection (for TypeORM)
# Use the Supabase Session Pooler host for IPv4 compatibility:
# aws-0-<region>.pooler.supabase.com (port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_HOST=aws-0-eu-west-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres.your-project-ref
DATABASE_PASSWORD=your_database_password
DATABASE_LOGGING=true

# App Runtime
ENV=DEV
PORT=3000

# Auth
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=your_64_char_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_other_64_char_hex_secret
JWT_REFRESH_EXPIRES_IN=30d

# Seeding — default admin account created on first run
DEFAULT_ADMIN_ADDRESS=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Deep Links & App Identity
# Set to your deployed backend URL so invite emails contain an https:// link
DEEP_LINK_BASE_URL=https://api.yourdomain.com
ANDROID_PACKAGE_NAME=tech.mybat.app
# Get with: keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android
ANDROID_SHA256_FINGERPRINT=your_sha256_fingerprint

# Mailtrap (transactional email)
# API token from: Mailtrap dashboard → API Tokens
MAILTRAP_API_TOKEN=your_mailtrap_api_token
# Must be a verified sender address in your Mailtrap account
MAILTRAP_FROM=no-reply@yourdomain.com
